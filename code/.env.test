MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=test
MINIO_SECRET_KEY=test
MINIO_SECURE=False

# Keep the security middleware off in tests: it's disabled by default only
# via docker-compose's dev environment override, not by the ENVIRONMENT
# default, so it must be disabled explicitly here too.
SECURITY_MIDDLEWARE_ENABLED=False

SIGNING_PRIVATE_KEY_PATH=../docker/secrets/signing-key.pem.example
SIGNING_CERTIFICATE_PATH=../docker/secrets/signing-cert.pem.example