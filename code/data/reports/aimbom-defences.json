  "components" : [ {
    "type" : "library",
    "bom-ref" : "ce6b36f8-ae19-4529-b112-b07564abcdf6",
    "group" : "DEF-002",
    "name" : "Input Purification and Reconstruction",
    "description" : "Online or preprocessing transformations that project suspicious inputs back toward the training data manifold before inference. Covers DU-AP (deep unrolled, perception-aware purification for LiDAR range images) as well as autoencoder-based reconstruction, Defense-GAN-style approaches, and diffusion-based purification."
  }, {
    "type" : "library",
    "bom-ref" : "8e5ec321-89fa-4363-96da-1f9f578c145f",
    "group" : "DEF-003",
    "name" : "Poisoning and Backdoor Defences",
    "description" : "Methods for detecting and mitigating poisoning and backdoor attacks affecting training data or model weights. Includes PGRL (prototype-guided robust learning with Label Consistency Verification), k-NN Label Consistency Filtering, statistical detectors for forgetting attacks, and PEFTGuard for weight-based backdoor detection in fine-tuned models from untrusted sources."
  }, {
    "type" : "library",
    "bom-ref" : "234dda6d-3cd6-4e54-b82d-0bc803249a29",
    "group" : "DEF-005",
    "name" : "Robust Federated Learning Aggregation",
    "description" : "Server-side aggregation strategies that mitigate poisoning attacks in federated learning. Groups SecureFL's Loss-Based Clustering and FedGreed mechanisms, CoEvoNEAT's coevolutionary robustness against label-flipping, and centralized context-aware FL with norm-based outlier detection, reputation scoring, and automatic switching to robust aggregators such as Trimmed Mean."
  } ],
