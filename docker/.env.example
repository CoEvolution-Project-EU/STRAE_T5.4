# Profiles: dev, prod, kafka
COMPOSE_PROFILES=dev

# --------------------------------------------------
# Common
# --------------------------------------------------
LOG_LEVEL=INFO

# Rate limiting / concurrency limiting / request size limiting middleware.
# NOTE: this is set explicitly per service (api, api-dev) in
# docker-compose.yml, which takes precedence over this file. Change it there,
# not here, to affect a specific profile. See docker/docker.md.
# SECURITY_MIDDLEWARE_ENABLED=True

SIGNING_PRIVATE_KEY_PATH=/run/secrets/signing-key.pem
SIGNING_CERTIFICATE_PATH=/run/secrets/signing-cert.pem

# --------------------------------------------------
# Orchestrator integration (USED BY: prod, kafka)
# --------------------------------------------------
ORCHESTRATOR_API_BASE_URL=http://localhost:8000/api/v1/

KEYCLOAK_BASE_URL=http://keycloak.example.com/
KEYCLOAK_REALM=realm
KEYCLOAK_CLIENT_ID=client

# Optional: required `aud` claim of incoming access tokens. Leave unset to
# skip the audience check.
# KEYCLOAK_AUDIENCE=strae

# Token authentication on /api/sign and /api/generate. Set per service in
# docker-compose.yml (true for api, false for api-dev), which takes
# precedence over this file. See docker/docker.md.
# AUTH_ENABLED=True

ORCHESTRATOR_USERNAME=username
ORCHESTRATOR_PASSWORD=password

# --------------------------------------------------
# Kafka Profile
# --------------------------------------------------
KAFKA_TOPIC=topic
KAFKA_SIGNING_TOPIC=signing-topic
KAFKA_BOOTSTRAP_SERVERS=bootstrap
KAFKA_GROUP_ID=group
KAFKA_SIGNING_GROUP_ID=signing-group
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_SIGNING_AUTO_OFFSET_RESET=latest

# --------------------------------------------------
# Development Profile (local MinIO)
# --------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MINIO_ENDPOINT=minio:9000
MINIO_SECURE=False
