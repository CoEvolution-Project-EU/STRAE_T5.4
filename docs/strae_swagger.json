{
    "openapi": "3.1.0",
    "info": {
        "title": "STR Assurance Engine API",
        "description": "\nThe **Security, Trust, Robustness Assurance Engine (STRAE)** of the CoEvolution Hub.\n\nSTRAE signs the security reports produced by the CoEvolution components and\nbuilds from them an **AI Model Bill of Materials (AIMBOM)**: a signed\n[CycloneDX](https://cyclonedx.org) document describing an assessed AI model\nversion.\n\n## Operations\n\n| Endpoint | Purpose |\n|---|---|\n| `POST /api/sign` | Sign reports and upload the signed copies to their target bucket. |\n| `POST /api/generate` | Generate the signed AIMBOM of an AI model version from its reports. |\n| `GET /api/validation/{uuid}/{version}` | Check that an AIMBOM and the reports it references are valid, correctly signed and consistent with each other. |\n| `GET /api/status` | Health check. |\n\nSigning and generation are also triggered by Kafka events, through the\nSTRAE worker.\n",
        "version": "1.0.0"
    },
    "paths": {
        "/api/status": {
            "get": {
                "tags": [
                    "api"
                ],
                "summary": "Get Status",
                "description": "Retrieve the operational status of the STR Assurance Engine API.\n\nThis endpoint can be used for health checks, service monitoring, and\ndeployment validation. A successful response indicates that the API is\nrunning and able to process requests.\n\n**Response**\n\nReturns the current service status and API version.",
                "operationId": "get_status_api_status_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/StatusResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/sign": {
            "post": {
                "tags": [
                    "api"
                ],
                "summary": "Sign Report",
                "description": "Digitally sign reports using the configured signing certificate and private key.\n\nEach file is downloaded, signed and uploaded to `target_pool` /\n`target_bucket` as a signed copy of the original. Files that have already\nbeen signed are treated as done.\n\n**Request Body**\n\n`signing_metadata`: The files to sign and where to upload the signed\ncopies, in the format of the `strae_sign_requests` Kafka event.\n\n**Response**\n\nReturns the destination, the files of the request, and how many of them\nwere signed by this request (`signed`) or had already been signed\n(`already_signed`).",
                "operationId": "sign_report_api_sign_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SigningMetadata"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SignedReportResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A report to sign does not exist in storage.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The request body is invalid, a file is not a valid report, or storage rejected the signed copy.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnprocessableEntityResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "The signing material is unusable, a report could not be signed, or an unexpected error occurred.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Storage is unavailable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/generate": {
            "post": {
                "tags": [
                    "api"
                ],
                "summary": "Generate Aimbom",
                "description": "Generate an AIMBOM for a specific AI model version.\n\nThis endpoint aggregates the provided security reports and generates\nan AI Model Bill of Materials (AIMBOM).\n\n**Request Body**\n\n`generation_metadata`: Metadata describing the unique identifier and the\nversion of the AI model and the reports that should be included in the generated AIMBOM.\n\n**Response**\n\nReturns the serial number and metadata of the generated AIMBOM.",
                "operationId": "generate_aimbom_api_generate_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/GenerationMetadata"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "201": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AIMBOMGeneratedResponse"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "A required report does not exist in storage.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "The request body is invalid, a report is invalid, or storage rejected the generated AIMBOM.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UnprocessableEntityResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "The signing material is unusable, the AIMBOM could not be generated, or an unexpected error occurred.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Storage is unavailable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/validation/{uuid}/{version}": {
            "get": {
                "tags": [
                    "api"
                ],
                "summary": "Validate Aimbom",
                "description": "Validate the AIMBOM of a specific AI model version and its reports.\n\nThe AIMBOM and its reports are fetched from storage, validated against\nthe CycloneDX schema and their models, and the AIMBOM's references are\nchecked against the reports. Validation stops at the first problem.\n\n**Response**\n\n`status` is `VALID` if every check passed. If not, `status` is `INVALID`\nand `detail` describes the first problem found. Returns 404 if the model\nversion has no AIMBOM and 503 if storage is unavailable.",
                "operationId": "validate_aimbom_api_validation__uuid___version__get",
                "parameters": [
                    {
                        "name": "uuid",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Unique identifier of the AI model",
                            "title": "Uuid"
                        },
                        "description": "Unique identifier of the AI model",
                        "example": "163723c9-173b-4ce2-abc1-4de2b25a7012"
                    },
                    {
                        "name": "version",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "description": "Version of the AI model",
                            "title": "Version"
                        },
                        "description": "Version of the AI model",
                        "example": "v1.0"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AIMBOMValidationResponse"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "The model version has no AIMBOM.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "The AIMBOM or a report could not be read from storage, or an unexpected error occurred.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Storage is unavailable.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ErrorResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/dev/{model_uuid}/{model_version}/reports/{report_name}": {
            "post": {
                "tags": [
                    "dev"
                ],
                "summary": "Save Report",
                "operationId": "save_report_dev__model_uuid___model_version__reports__report_name__post",
