{
  "openapi": "3.1.0",
  "info": {
    "title": "STR Assurance Engine API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Get Status",
        "description": "Health check endpoint for the STRAE API.\n\nReturns:\n    StatusResponse - A response indicating the operational status and version information.",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sign": {
      "post": {
        "tags": [
          "api"
        ],
        "summary": "Sign Report",
        "description": "Sign the given report using the configured signing key.\n\nArgs:\n    report (Dict) - The report to be signed.\n\nReturns:\n    Dict - The signed report.",
        "operationId": "sign_report_api_sign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Report"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Sign Report Api Sign Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/generate/{model_id}": {
      "post": {
        "tags": [
          "api"
        ],
        "summary": "Generate Aimbom",
        "description": "Generate an AIMBOM for the given model ID by aggregating reports from MinIO.\n\nArgs:\n    model_id (str): The ID of the model for which to generate the AIMBOM.\n\nReturns:\n    AIMBOMGeneratedResponse - A response containing the details of the generated AIMBOM.",
        "operationId": "generate_aimbom_api_generate__model_id__post",
        "parameters": [
          {
            "name": "model_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Id"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIMBOMGeneratedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIMBOMGeneratedResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "model_id": {
            "type": "string",
            "minLength": 1,
            "title": "Model Id"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "id",
          "model_id"
        ],
        "title": "AIMBOMGeneratedResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "StatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}