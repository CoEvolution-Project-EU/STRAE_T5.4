                        "title": "Aimbom Uuid"
                    },
                    "aimbom_version": {
                        "type": "integer",
                        "minimum": 1.0,
                        "title": "Aimbom Version"
                    },
                    "model_uuid": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Model Uuid"
                    },
                    "model_version": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Model Version"
                    }
                },
                "type": "object",
                "required": [
                    "detail",
                    "aimbom_uuid",
                    "aimbom_version",
                    "model_uuid",
                    "model_version"
