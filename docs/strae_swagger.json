{
  "openapi": "3.1.0",
  "info": {
    "title": "STR Assurance Engine API",
    "description": "Collects the security reports from the rest of the CoEvolution components and generate, based on those reports, the AIMBOM for a given assessed/secured/robust AI model.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/status": {
      "get": {
        "tags": [
          "api"
        ],
        "summary": "Get Status",
        "description": "Retrieve the operational status of the STR Assurance Engine API.\n\nThis endpoint can be used for health checks, service monitoring, and\ndeployment validation. A successful response indicates that the API is\nrunning and able to process requests.\n\n**Response**\n\nReturns the current service status and API version.",
        "operationId": "get_status_api_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/sign": {
      "post": {
        "tags": [
          "api"
        ],
        "summary": "Sign Report",
        "description": "Digitally sign a report using the configured signing certificate and private key.\n\nThis endpoint applies a cryptographic signature to the provided report,\nallowing consumers to verify its authenticity and integrity.\n\n**Request Body**\n\n- `report`: A JSON report to be signed.\n\n**Response**\n\nReturns the signed report together with a confirmation message.",
        "operationId": "sign_report_api_sign_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Report"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignedReportResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/generate/{model_uuid}/{model_version}": {
      "post": {
        "tags": [
          "api"
        ],
        "summary": "Generate Aimbom",
        "description": "Generate an AIMBOM for a specific AI model version.\n\nThis endpoint aggregates the provided security reports and generates\nan AI Model Bill of Materials (AIMBOM).\n\n**Environment-specific behavior**\n\n- **Production**: `reports_metadata` is required and is used to retrieve\nthe reports from the Orchestrator.\n- **Development/Test**: `reports_metadata` is optional and reports are\nretrieved directly from the local storage backend.\n\n**Path Parameters**\n\n- `model_uuid`: Unique identifier of the AI model.\n- `model_version`: Version of the AI model.\n\n**Request Body**\n\n- `reports_metadata`: Metadata describing the reports that should be\nincluded in the generated AIMBOM.\n\n**Response**\n\nReturns the serial number and metadata of the generated AIMBOM.",
        "operationId": "generate_aimbom_api_generate__model_uuid___model_version__post",
        "parameters": [
          {
            "name": "model_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Uuid"
            }
          },
          {
            "name": "model_version",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Model Version"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/ReportsMetadata"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Reports Metadata"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIMBOMGeneratedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIMBOMGeneratedResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "model_uuid": {
            "type": "string",
            "minLength": 1,
            "title": "Model Uuid"
          },
          "model_version": {
            "type": "string",
            "minLength": 1,
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "id",
          "model_uuid",
          "model_version"
        ],
        "title": "AIMBOMGeneratedResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ReportDetails": {
        "properties": {
          "_id": {
            "type": "string",
            "title": "Id"
          },
          "bucket": {
            "type": "string",
            "title": "Bucket"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "download_url": {
            "type": "string",
            "title": "Download Url"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "_id",
          "bucket",
          "filename",
          "download_url",
          "createdAt"
        ],
        "title": "ReportDetails"
      },
      "ReportsMetadata": {
        "properties": {
          "risk_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "assessment_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "defence_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "gadgets_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "aimodelinfo_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "euaiact_report": {
            "$ref": "#/components/schemas/ReportDetails"
          },
          "datasets_report": {
            "$ref": "#/components/schemas/ReportDetails"
          }
        },
        "type": "object",
        "required": [
          "risk_report",
          "assessment_report",
          "defence_report",
          "gadgets_report",
          "aimodelinfo_report",
          "euaiact_report",
          "datasets_report"
        ],
        "title": "ReportsMetadata"
      },
      "SignedReportResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "signed_report": {
            "additionalProperties": true,
            "type": "object",
            "title": "Signed Report"
          }
        },
        "type": "object",
        "required": [
          "detail",
          "signed_report"
        ],
        "title": "SignedReportResponse"
      },
      "StatusResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "StatusResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}