{
  "openapi": "3.0.3",
  "info": {
    "title": "CoEvolution Hub Components API",
    "version": "0.1.0",
    "description": "API specification based on the currently identified endpoints."
  },
  "tags": [
    {
      "name": "Security Assurance Pool (SAP) (CBRL)"
    }
  ],
  "paths": {
    "/api/securityassurancepool/{model_uuid}": {
      "post": {
        "tags": ["Security Assurance Pool (SAP) (CBRL)"],
        "summary": "Store AIMBOM",
        "parameters": [
          {
            "name": "model_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "4ff2dab7-bffe-414d-88a5-1826b9fea8df"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AIMBOM"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "AIMBOM stored successfully"
          }
        }
      },
      "get": {
        "tags": ["Security Assurance Pool (SAP) (CBRL)"],
        "summary": "Get AIMBOM",
        "parameters": [
          {
            "name": "model_uuid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "4ff2dab7-bffe-414d-88a5-1826b9fea8df"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "AIMBOM retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AIMBOM"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AIMBOM": {
        "type": "object",
        "required": [
          "bomFormat",
          "specVersion",
          "serialNumber",
          "version",
          "metadata"
        ],
        "properties": {
          "bomFormat": {
            "type": "string",
            "example": "CycloneDX"
          },
          "specVersion": {
            "type": "string",
            "example": "1.7"
          },
          "serialNumber": {
            "type": "string",
            "format": "uri",
            "example": "urn:uuid:66e99e7e-3c13-44c7-b053-21cf3957e161"
          },
          "version": {
            "type": "integer",
            "example": 1
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          },
          "externalReferences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExternalReference"
            }
          },
          "signature": {
            "type": "object",
            "description": "Digital signature object (structure depends on signing implementation)",
            "additionalProperties": true
          }
        }
      },
      "Metadata": {
        "type": "object",
        "required": ["timestamp", "component"],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2026-04-01T09:46:22.290507Z"
          },
          "component": {
            "$ref": "#/components/schemas/Component"
          },
          "supplier": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "example": "coevolution-project.eu"
              }
            }
          },
          "tools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tool"
            }
          }
        }
      },
      "Component": {
        "type": "object",
        "required": ["bom-ref", "type", "name", "version"],
        "properties": {
          "bom-ref": {
            "type": "string",
            "example": "model-4ff2dab7-bffe-414d-88a5-1826b9fea8df"
          },
          "type": {
            "type": "string",
            "example": "machine-learning-model"
          },
          "name": {
            "type": "string",
            "example": "Autonomous Perception Model"
          },
          "version": {
            "type": "string",
            "example": "1.0"
          },
          "supplier": {
            "$ref": "#/components/schemas/Supplier"
          },
          "hashes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Hash"
            }
          }
        }
      },
      "Supplier": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "AVISENSE.ai"
          }
        }
      },
      "Hash": {
        "type": "object",
        "required": ["alg", "content"],
        "properties": {
          "alg": {
            "type": "string",
            "example": "SHA-256"
          },
          "content": {
            "type": "string",
            "example": "6fce8a2c0b7a31c21db94c76fd43b1c4f0f16fabc4e7e984f3e9b82c50a2f3ab"
          }
        }
      },
      "Tool": {
        "type": "object",
        "properties": {
          "vendor": {
            "type": "string",
            "example": "CoEvolution Project"
          },
          "name": {
            "type": "string",
            "example": "Assurance Engine"
          },
          "version": {
            "type": "string",
            "example": "1.0.0"
          }
        }
      },
      "ExternalReference": {
        "type": "object",
        "required": ["type", "url"],
        "properties": {
          "type": {
            "type": "string",
            "example": "bom"
          },
          "url": {
            "type": "string",
            "format": "uri",
            "example": "urn:cdx:9a2f63de-bb87-4c30-a1aa-1c95d27c45a2/1"
          },
          "comment": {
            "type": "string",
            "example": "aimodelinfo"
          }
        }
      }
    }
  }
}